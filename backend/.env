NODE_ENV=development
PORT=3000

# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/db?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017/academy_hub

# Optional CORS origin. Use "*" for all origins.
CORS_ORIGIN=*
PORT=8080
# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Password hashing
BCRYPT_SALT_ROUNDS=10

# Admin creation through Postman-only endpoint (/api/auth/create-admin)
ADMIN_CREATION_KEY=change_me_admin_setup_key
